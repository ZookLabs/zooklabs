{
  "tasks": {
    "deploy": "deployctl deploy --project=zooklabs --prod",
    "deploy-test": "deployctl deploy --project=zooklabs",
    "test:db": "deno run --env=.env.development --allow-all tests/integration/db/migrations_test.ts",
    "check-all": "deno fmt && deno lint && deno check **/*.ts",
    "dev": "deno run --env-file=.env.development --env-file=.env.local --allow-env --allow-read --allow-write --allow-net --unstable-cron --watch main.ts",
    "migrate": "deno run --allow-env --allow-read --allow-net db/migrate.ts --up-full",
    "dev:local": "sh -c 'docker-compose up -d --wait && deno task migrate && deno task dev'",
    "dev:stop": "docker-compose down",
    "test:unit": "deno test tests/unit",
    "test:integration": "deno run -A tests/setup_integration.ts",
    "test:all": "deno task test:unit && deno task test:integration"
  },
  "deploy": {
    "project": "82b0b482-0d0f-4007-9d63-49e2864526ae",
    "exclude": ["**/node_modules"],
    "include": [],
    "entrypoint": "main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "canvas": "https://deno.land/x/canvas@v1.4.2/mod.ts",
    "compress": "https://deno.land/x/compress@v0.5.6/mod.ts",
    "djwt": "https://deno.land/x/djwt@v3.0.2/mod.ts",
    "cors": "https://deno.land/x/cors@v1.2.2/mod.ts",
    "kysely": "npm:kysely@^0.28.7",
    "pg": "npm:pg@^8.22.0",
    "oak": "https://deno.land/x/oak@v13.2.5/mod.ts",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts",
    "oak-middleware-jwt": "https://deno.land/x/oak_middleware_jwt@2.2.2/mod.ts",
    "blowfish": "https://deno.land/x/crypto@v0.11.0/blowfish.ts",
    "block-modes": "https://deno.land/x/crypto@v0.11.0/block-modes.ts",
    "@std/encoding/hex": "jsr:@std/encoding@^1.0.0/hex",
    "@google-cloud/storage": "npm:@google-cloud/storage@^7.21.0",
    "date-fns": "npm:date-fns@^4.4.0",
    "xml": "https://deno.land/x/xml@7.0.4/mod.ts",
    "docker-compose": "npm:docker-compose@^1.4.2"
  }
}
