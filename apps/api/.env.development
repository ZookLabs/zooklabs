USE_LOCAL_PERSISTENCE='true'
# Sensitive keys — set real values in .env.local (gitignored), which overrides this file.
# These placeholders let the API start without .env.local but uploads will fail decryption.
ZOOK_CORE_KEY='21 21 21 21 21'
ZOOK_CORE_HEADER='21 21 21 21 21'
DISCORD_WEBHOOK='https://discord.com/404'
JWT_KEY='21 21 21 21 21'

# Local dev (see scripts/dev.ts): in-memory PGlite on 127.0.0.1:5432,
# API on :8080 to match the web's REACT_APP_DENO_API_URL, and allow the local web origin.
PGHOST='127.0.0.1'
APP_PORT='8080'
CORS_ORIGIN='http://localhost:3000'

# Set to 'false' to disable immediate league recalculation on upload (default: enabled)
# RECALCULATE_LEAGUES_ON_UPLOAD=false